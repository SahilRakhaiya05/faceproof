# Optional free-tier Google Lens search through SerpApi.
# The Bluesky public author-feed route needs no API key; its actor is supplied per run.
SERPAPI_API_KEY=

# OpenCV model files downloaded by: faceproof models download
FACEPROOF_MODEL_DIR=models

# Base Sepolia defaults. Use a dedicated testnet-only wallet.
FACEPROOF_RPC_URL=https://sepolia.base.org
FACEPROOF_CHAIN_ID=84532
FACEPROOF_CONTRACT_ADDRESS=
# Required for anchoring and chain verification: keccak256 of registry runtime bytecode.
FACEPROOF_CONTRACT_CODE_HASH=
FACEPROOF_PRIVATE_KEY=
FACEPROOF_CONFIRMATIONS=1

# Optional absolute paths used only by `faceproof local-demo` when Foundry is
# not on PATH and is not installed under this repository's .tools/foundry tree.
# Manual forge/cast commands still require their executable directory on PATH.
FACEPROOF_FORGE_PATH=
FACEPROOF_ANVIL_PATH=

# Git commit used for a submission/demo run (for example: git rev-parse HEAD).
FACEPROOF_SOURCE_REVISION=

# Optional evidence settings
FACEPROOF_OUTPUT_DIR=evidence
FACEPROOF_HTTP_TIMEOUT_SECONDS=30
